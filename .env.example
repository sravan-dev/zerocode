# Copy to .env (local) or set in your hosting panel (Coolify / Docker).

# Required on any public server: clients and the dashboard must send this key.
ZEROCODE_PROXY_KEY=

# Optional: configure Antigravity here, or enter these in Zero Code > Connectors.
# Use a Google OAuth Desktop client. Callback: http://localhost:<PORT>/oauth2callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# User accounts (SaaS mode): sign-in page, per-user chats and the /manage admin portal.
# Leave MONGODB_URI empty to run single-user without sign-in.
MONGODB_URI=
# These emails always get the admin role (comma-separated).
SUPER_ADMIN_EMAILS=

# Hosted deployments: public base URL, e.g. https://zerocode.example.com.
# Google then redirects to <PUBLIC_URL>/oauth2callback; register that URI on a
# Web application OAuth client.
PUBLIC_URL=

# Some Google accounts require an existing Google Cloud project for Code Assist.
GOOGLE_CLOUD_PROJECT=
