# Copy to .env (local) or set in your hosting panel (Coolify / Docker).

# Required on any public server: clients and the dashboard must send this key.
TOKEN_ROUTE_PROXY_KEY=

# Optional: enables "Sign in with Google" for the Google Antigravity provider.
# Use an installed-app (Desktop) OAuth client whose redirect URI allows http://localhost.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
